{
	"name": "glasp-obsidian-plugin",
	"version": "0.4.6",
	"description": "Obsidian plugin to import your Glasp web and Kindle highlights, summaries and bookmarks into your vault.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"tsc": "tsc -noEmit",
		"format:fix": "biome format --write src",
		"format:check": "biome format src",
		"lint:fix": "biome check --write --unsafe src",
		"lint:check": "biome check src",
		"prepare": "lefthook install || exit 0"
	},
	"keywords": [
		"obsidian",
		"glasp"
	],
	"author": "Glasp",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "22.19.19",
		"esbuild": "0.28.2",
		"lefthook": "1.10.1",
		"typescript": "5.7.2",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"handlebars": "4.7.10",
		"obsidian": "1.7.2",
		"tslib": "2.8.1"
	},
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=24.0.0"
	},
	"overrides": {
		"obsidian": {
			"moment": "2.31.0"
		},
		"vite": "$vite"
	}
}
